                  |
              ENDOF AREAS
#
              BEGIN ARHES        1
#              Arrhenius shear stress law
              .   1   1   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| h(t) = exp( alfa / (t-t0) - alfa / (talfa-t0) )
                  |
              ENDOF ARHES
#
              BEGIN MIXED        1
#              Mixed dependence
              .   1   1   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79|h(t,g) = 10**( a2*(t-t0) + a22*(t-t0)**2 + a12*(t-t0)*lo
                  |g(g/gcrit) )
              ENDOF MIXED
#
              BEGIN FULCH        1
#              Fulcher dependence
              .   1   0   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| h(t) = 10 ** ( -F1 + F2 / (t-F3) )
                  |
              ENDOF FULCH
#
              BEGIN WLFV         1
#              WLF dependence
              .   1   0   1
