              .   1   0   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79|Ag = a + b*(t-t0) + c*(t-t0)**2 + d*(t-t0)**3
                  |
              D  1| 0.0000000E+00
              ENDOF GDILF
#
              BEGIN LDILF        1
