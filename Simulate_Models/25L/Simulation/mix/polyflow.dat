            .   1   0   1
            C 79|Elastic data
                |
            D  5| 1.0000000E+00 2.5000000E-01 0.0000000E+00 0.0000000E+00
                | 0.0000000E+00
            I  3|       1       1       1
            D  5| 0.0000000E+00 0.0000000E+00 0.0000000E+00 0.0000000E+00
                | 0.0000000E+00
            D  5| 0.0000000E+00 0.0000000E+00 0.0000000E+00 0.0000000E+00
                | 0.0000000E+00
            D  5| 0.0000000E+00 0.0000000E+00 0.0000000E+00 0.0000000E+00
                | 0.0000000E+00
            L  1|   T
            L  1|   T
            ENDOF YOUNG
#
            BEGIN PRMSH        1
#            Layer permeability
            .   1   1   1
            D  1| 1.0000000E+00
            ENDOF PRMSH
#
            BEGIN CRYST        1
#            Mat. Data for crystallisation
            .   1   0   1
            D  1| 1.0000000E+00
            D  1| 1.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            D  1| 2.0000000E+02
            D  1| 2.0000000E-01
            D  1| 6.0000000E+01
            D  1| 1.0000000E-03
            D  1| 1.0000000E-02
            D  1| 6.0000000E-02
            D  1| 1.0000000E+00
            D  1| 0.0000000E+00
            D  1| 1.0000000E+00
            D  1|-1.0000000E+00
            D  1| 0.0000000E+00
            D  1| 1.0000000E+00
#
              BEGIN HCAPC        1
#              Heat capacity for semi-crystalline phase
              .   1   0   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79|Amorphous phase
                  |
              C 79|  Cpa = Cpa0 + Cpa1*(t-t0)
                  |
              C 79|            + Cpa2*(t-t0)**2 + Cpa3*(t-t0)**3
                  |
              C 79|Semi-crystalline phase
                  |
              C 79|  Cpsc = Cpsc0 + Cpsc1*(t-t0)
                  |
              C 79|          + Cpsc2*(t-t0)**2 + Cpsc3*(t-t0)**3
                  |
              D  1| 0.0000000E+00
              ENDOF HCAPC
#
              BEGIN VSTPC        1
#              Temperature dependence for relax_a
              .   1   0   1
              I  1|       1
#
                BEGIN CSTTP        1
#                No temperature dependence
                .   1   1   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| No temperature dependence of the viscosity : h(t) = 1
                    |
                ENDOF CSTTP
#
                BEGIN AREAP        1
#                Arrhenius approximate law
                .   1   0   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| h(t) = exp( -alfa * (t - talfa) )
                    |
                ENDOF AREAP
#
                BEGIN ARRHE        1
#                Arrhenius law
                .   1   1   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| h(t) = exp( alfa / (t-t0) - alfa / (talfa-t0) )
                    |
                ENDOF ARRHE
#
                BEGIN WLFV         1
#                WLF dependence
                .   1   0   1
                D  1| 8.8600000E+00
                D  1| 1.0160000E+02
                D  1| 3.0000000E+02
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| ln(h(t)) = c1*(Tr-Ta)/(c2+Tr-Ta)-c1*(T-Ta)/(c2+T-Ta)
                    |
                ENDOF WLFV
              ENDOF VSTPC
            ENDOF CRYST
#
            BEGIN LIGHT        1
#            Simplified Viscoelastic Model
            .   1   0   1
            L  1|   T
            D  1| 1.0000000E+00
#
              BEGIN FNVIS        1
#              First Normal Viscosity
              .   1   0   1
              I  1|       1
              L  1|   T
#
                BEGIN CSTGA        1
#                Constant viscosity
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = fac
                    |
                ENDOF CSTGA
#
                BEGIN BIRCA        1
#                Bird-Carreau law
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = facinf + (fac-facinf) *
                    |
                C 79|        [1+(tnat*k)**2]**((expo-1)/2)
                    |
                ENDOF BIRCA
#
                BEGIN POWER        1
#                Power law
                .   1   1   1
                D  1| 1.0000000E+00
                D  1| 1.0000000E+00
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = fac * (tnat*k)**(expo-1)
                    |
                ENDOF POWER
#
                BEGIN CROSS        1
#                Cross law
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = fac/ (1 + ( tnat*k )**expom)
                    |
                ENDOF CROSS
#
                BEGIN YASUD        1
#                Carreau-Yasuda law
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 1.0000000E+00
                C 79| f(k) = facinf + (fac-facinf) *
                    |
                C 79|        [1+(tnat*k)**expoa]**((expo-1)/expoa)
                    |
                ENDOF YASUD
#
                BEGIN MDCRO        1
#                modified Cross law
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79|f(k) = fac / ( 1 + tnat * k ) ** expom
                    |
                ENDOF MDCRO
              ENDOF FNVIS
#
              BEGIN SRRLX        1
#              Shear-rate dependence of relaxation time
              .   1   0   1
              I  1|       1
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              ENDOF SRRLX
            ENDOF LIGHT
#
            BEGIN NARAMY       1
#            Data for Narayanaswamy model
            .   1   0   1
#
              BEGIN BRELM        1
#              Bulk relaxation modulus
              .   1   0   1
              D  1| 1.0000000E+00
              D  8| 0.0000000E+00 0.0000000E+00 0.0000000E+00 0.0000000E+00
                  | 0.0000000E+00 0.0000000E+00 0.0000000E+00 0.0000000E+00
              D  8| 1.0000000E+00 1.0000000E+00 1.0000000E+00 1.0000000E+00
                  | 1.0000000E+00 1.0000000E+00 1.0000000E+00 1.0000000E+00
              I  1|       0
              ENDOF BRELM
#
              BEGIN GRELM        1
