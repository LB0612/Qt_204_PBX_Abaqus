              |
          D  1| 0.0000000E+00
          ENDOF CSTSG
#
          BEGIN LINSG        1
#          Linear conductivity
          .   1   1   1
          D  1| 1.0000000E+00
          D  1| 0.0000000E+00
          D  1| 0.0000000E+00
          C 79|sig(t) = a + b * (t-t0)
              |
          D  1| 0.0000000E+00
