#              Temperature dependence of viscosity
              .   1   0   1
              I  1|       1
#
                BEGIN CSTTP        1
#                No temperature dependence
                .   1   1   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| No temperature dependence of the viscosity : h(t) = 1
                    |
                ENDOF CSTTP
#
                BEGIN AREAP        1
#                Arrhenius approximate law
                .   1   0   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| h(t) = exp( -alfa * (t - talfa) )
                    |
                ENDOF AREAP
#
                BEGIN ARRHE        1
#                Arrhenius law
                .   1   1   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| h(t) = exp( alfa / (t-t0) - alfa / (talfa-t0) )
                    |
                ENDOF ARRHE
#
                BEGIN AREAS        1
#                Arrhenius approximate shear stress law
                .   1   0   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| h(t) = exp( -alfa * (t - talfa) )
                    |
                ENDOF AREAS
#
                BEGIN ARHES        1
#                Arrhenius shear stress law
                .   1   1   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| h(t) = exp( alfa / (t-t0) - alfa / (talfa-t0) )
                    |
                ENDOF ARHES
#
                BEGIN MIXED        1
#                Mixed dependence
                .   1   1   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79|h(t,g) = 10**( a2*(t-t0) + a22*(t-t0)**2 + a12*(t-t0)*lo
                    |g(g/gcrit) )
                ENDOF MIXED
#
                BEGIN FULCH        1
#                Fulcher dependence
                .   1   0   1
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| h(t) = 10 ** ( -F1 + F2 / (t-F3) )
                    |
                ENDOF FULCH
#
                BEGIN WLFV         1
#                WLF dependence
                .   1   0   1
                D  1| 8.8600000E+00
                D  1| 1.0160000E+02
                D  1| 3.0000000E+02
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| ln(h(t)) = c1*(Tr-Ta)/(c2+Tr-Ta)-c1*(T-Ta)/(c2+T-Ta)
                    |
                ENDOF WLFV
#
                BEGIN WLFH         1
#                WLF shear stress dependence
                .   1   0   1
                D  1| 8.8600000E+00
                D  1| 1.0160000E+02
                D  1| 3.0000000E+02
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| ln(h(t)) = c1*(Tr-Ta)/(c2+Tr-Ta)-c1*(T-Ta)/(c2+T-Ta)
                    |
                ENDOF WLFH
              ENDOF VISTP
#
              BEGIN RELAX        1
#              Relaxation mode
              .   1   0   1
              C 79|Relaxation mode  1
                  |
              I  1|       1
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              ENDOF RELAX
            ENDOF VINTG
#
            BEGIN MASPE        1
#            Density
            .   1   2   1
            D  1| 8.0300000E-09
            D  1| 1.0000000E+00
            I  1|       0
            ENDOF MASPE
#
            BEGIN INERT        1
#            Inertia terms
            .   1   0   1
            L  1|   F
            ENDOF INERT
#
            BEGIN VOLEX        1
#            Coefficient of thermal expansion
            .   1   0   1
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            C 79| The density will be given by :   ro*( 1 - beta*( t - tb
                |eta) )
            C 79|
                |
            C 79|     where  - ro is the reference density introduced in
                |the 'density' menu
            C 79|            - beta is the coefficient of thermal expansi
                |on
            C 79|            - tbeta is a reference temperature
                |
            ENDOF VOLEX
#
            BEGIN CONDU        1
#            Thermal conductivity
            .   1   1   1
            D  1| 1.4500000E+01
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            C 79|condu = a + b*(t-t0) + c*(t-t0)**2 + d*(t-t0)**3
                |
            D  1| 0.0000000E+00
            ENDOF CONDU
#
            BEGIN HECAP        1
#            Heat capacity per unit mass
            .   1   1   1
            D  1| 5.0200000E+02
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            C 79|Cp = a + b*(t-t0) + c*(t-t0)**2 + d*(t-t0)**3
                |
            D  1| 0.0000000E+00
            ENDOF HECAP
#
            BEGIN CONVE        1
#            Heat convection
            .   1   0   1
            L  1|   F
            ENDOF CONVE
#
            BEGIN VHEAT        1
#            Viscous (+ Wall friction) heating
            .   1   1   1
            L  1|   F
            D  1| 1.0000000E+00
            ENDOF VHEAT
#
            BEGIN GRAVI        1
#            Gravity
            .   1   0   1
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            ENDOF GRAVI
#
            BEGIN TINIT        1
#            Average estimate
            .   1   2   1
            C 79|Average temperature
                |
            D  5| 3.0000000E+02 0.0000000E+00 0.0000000E+00 0.0000000E+00
                | 0.0000000E+00
#
              BEGIN CSVMP        1
#              Map from CSV file
              .   1   1   1
              C 200|csv
                   |
                   |
                   |
              C 79|TEMPERATURE
                  |
              I  4|       0       0       0       0
              ENDOF CSVMP
            ENDOF TINIT
#
            BEGIN PRODQ        1
#            Source per unit volume
            .   1   1   1
            C 79|Heat source per unit volume
                |
            D  1| 0.0000000E+00
            ENDOF PRODQ
#
            BEGIN ADVCO        1
#            Carrier fluid concentration
            .   1   0   1
            D  1| 1.0132500E+05
            D  1| 8.3143000E+00
            C 79|Ideal gas law : c(T) = Po / Rg * T
                |
            ENDOF ADVCO
#
            BEGIN ADVDF        1
#            Diffusivity
            .   1   1   1
            D  1| 1.0000000E+00
            D  1| 0.0000000E+00
            C 79|Power law : D(T) = fact * (T)**expo
                |
            I  1|       0
            D  1| 1.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            ENDOF ADVDF
#
            BEGIN ADVAT        1
#            Thermal diffusion factor
            .   1   0   1
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            C 79|Polynomial law : a(T) = a0 + a1 *T + a2 *T*T
                |
            ENDOF ADVAT
#
            BEGIN ADVEC        1
#            Advection term
            .   1   0   1
            C 79|Disable advection term
                |
            L  1|   T
            ENDOF ADVEC
#
            BEGIN SIGTY        1
#            Electrical conductivity
            .   1   0   1
            I  1|       1
#
              BEGIN CSTSG        1
#              Constant conductivity
              .   1   1   1
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79|sig(t) = a
                  |
              D  1| 0.0000000E+00
              ENDOF CSTSG
#
              BEGIN LINSG        1
#              Linear conductivity
              .   1   1   1
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79|sig(t) = a + b * (t-t0)
                  |
              D  1| 0.0000000E+00
              ENDOF LINSG
#
              BEGIN EXPSG        1
#              Exponential conductivity
              .   1   1   1
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79|sig(t) = a * exp ( b - c/(t-t0) )
                  |
              D  1| 0.0000000E+00
              ENDOF EXPSG
#
              BEGIN POLSG        1
#              Polynomial conductivity
              .   1   1   1
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79|sig(t) = a + b * (t-t0) + c * (t-t0)^2 + d * (t-t0)^3
                  |
              D  1| 0.0000000E+00
              ENDOF POLSG
            ENDOF SIGTY
#
            BEGIN UNITS        1
#            Change System of Units
            .   1   0   1
            L  1|   F
            C 79|meter
                |
            C 79|kilogram
                |
            C 79|second
                |
            C 79|Kelvin
                |
            C 79|Ampere
                |
            L  1|   F
            C 79|meter
