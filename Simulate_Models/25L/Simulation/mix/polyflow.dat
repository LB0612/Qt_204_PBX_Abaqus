              D  1| 1.0160000E+02
              D  1| 3.0000000E+02
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| ln(h(t)) = c1*(Tr-Ta)/(c2+Tr-Ta)-c1*(T-Ta)/(c2+T-Ta)
                  |
              ENDOF WLFV
#
