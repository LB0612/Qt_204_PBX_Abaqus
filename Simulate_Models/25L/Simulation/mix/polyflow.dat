            D  1| 0.0000000E+00
            D  1| 3.0000000E+02
            C 79|Power law : k(T) = fact * (T/Tref)**expo
                |
            ENDOF CVDK
#
            BEGIN VISTP        1
#            Temperature dependence of viscosity
            .   1   0   1
            I  1|       1
#
              BEGIN CSTTP        1
#              No temperature dependence
              .   1   1   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| No temperature dependence of the viscosity : h(t) = 1
                  |
              ENDOF CSTTP
#
              BEGIN AREAP        1
#              Arrhenius approximate law
              .   1   0   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| h(t) = exp( -alfa * (t - talfa) )
                  |
              ENDOF AREAP
#
              BEGIN ARRHE        1
#              Arrhenius law
              .   1   1   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| h(t) = exp( alfa / (t-t0) - alfa / (talfa-t0) )
                  |
              ENDOF ARRHE
#
              BEGIN AREAS        1
#              Arrhenius approximate shear stress law
              .   1   0   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
