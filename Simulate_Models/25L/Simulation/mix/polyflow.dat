            D  1| 1.0000000E+00
            D  1| 1.0000000E+00
            D  1| 0.0000000E+00
            D  1| 0.0000000E+00
            C 79| f(k) = fac * (tnat*k)**(expo-1)
                |
            ENDOF POWER
#
            BEGIN CROSS        1
