              D  8| 0.0000000E+00 0.0000000E+00 0.0000000E+00 0.0000000E+00
                  | 0.0000000E+00 0.0000000E+00 0.0000000E+00 0.0000000E+00
              D  8| 1.0000000E+00 1.0000000E+00 1.0000000E+00 1.0000000E+00
                  | 1.0000000E+00 1.0000000E+00 1.0000000E+00 1.0000000E+00
              I  1|       0
              ENDOF GRELM
#
              BEGIN SRELM        1
