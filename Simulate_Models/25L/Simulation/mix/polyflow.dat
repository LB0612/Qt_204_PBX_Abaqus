              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| f(g) = fac * (tnat*g)**(expo-1)
                  |
              ENDOF POWER
#
              BEGIN BINGA        1
#              Bingham law
              .   1   0   1
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              C 79|         f(g) = fac + ystr/g                         whe
                  |n g >= gcrit
              C 79|              = fac + ystr/gcrit*(2-g/gcrit)         whe
                  |n g < gcrit
              ENDOF BINGA
#
              BEGIN HERSH        1
#              Herschel-Bulkley law
              .   1   1   1
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              C 79|f(g) = fac1 / g + fac2 * (g/gcrit) ** (expo-1)        wh
                  |en g > gcrit
              C 79|     = fac1 * [ 2 - g/gcrit ] / gcrit
                  |
              C 79|     + fac2 * [ (2-expo) + (expo-1) * g/gcrit ]       wh
                  |en g < gcrit
              C 79|
                  |
              ENDOF HERSH
#
              BEGIN CROSS        1
#              Cross law
              .   1   0   1
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              C 79| f(g) = fac/ (1 + ( tnat*g )**expom)
                  |
              ENDOF CROSS
#
              BEGIN LOGLW        1
#              Log-Log law
              .   1   1   1
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 0.0000000E+00
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              C 79|f(g) = fac * 10**( a0 +a1*log(g/gcrit) +a11*log(g/gcrit)
                  |**2 )
              ENDOF LOGLW
#
              BEGIN MDBIN        1
#              modified Bingham law
              .   1   0   1
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              C 79| f(g) = fac + ystr*(1-exp(-m*g))/g
                  |
              C 79| where m = 3/gcrit
                  |
              ENDOF MDBIN
#
              BEGIN MDHER        1
#              modified Herschel-Bulkley law
              .   1   1   1
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 1.0000000E+00
              D  1| 0.0000000E+00
              C 79| f(g) = fac1 * ( 1 - exp( -3 * g / gcrit ) ) / g
                  |
              C 79|      + fac2 * ( g / gcrit ) ** (expo-1)
                  |
              C 79|
                  |
              C 79|
                  |
              ENDOF MDHER
