                D  1| 1.0160000E+02
                D  1| 3.0000000E+02
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| ln(h(t)) = c1*(Tr-Ta)/(c2+Tr-Ta)-c1*(T-Ta)/(c2+T-Ta)
                    |
                ENDOF WLFV
              ENDOF VSTPC
            ENDOF CRYST
#
            BEGIN LIGHT        1
#            Simplified Viscoelastic Model
            .   1   0   1
            L  1|   T
            D  1| 1.0000000E+00
#
              BEGIN FNVIS        1
#              First Normal Viscosity
              .   1   0   1
              I  1|       1
              L  1|   T
#
                BEGIN CSTGA        1
#                Constant viscosity
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = fac
                    |
                ENDOF CSTGA
#
                BEGIN BIRCA        1
#                Bird-Carreau law
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = facinf + (fac-facinf) *
                    |
                C 79|        [1+(tnat*k)**2]**((expo-1)/2)
                    |
                ENDOF BIRCA
#
                BEGIN POWER        1
#                Power law
                .   1   1   1
                D  1| 1.0000000E+00
                D  1| 1.0000000E+00
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = fac * (tnat*k)**(expo-1)
                    |
                ENDOF POWER
#
                BEGIN CROSS        1
#                Cross law
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                D  1| 0.0000000E+00
                C 79| f(k) = fac/ (1 + ( tnat*k )**expom)
                    |
                ENDOF CROSS
#
                BEGIN YASUD        1
#                Carreau-Yasuda law
                .   1   0   1
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 1.0000000E+00
                D  1| 0.0000000E+00
                D  1| 1.0000000E+00
                C 79| f(k) = facinf + (fac-facinf) *
                    |
                C 79|        [1+(tnat*k)**expoa]**((expo-1)/expoa)
                    |
                ENDOF YASUD
#
                BEGIN MDCRO        1
